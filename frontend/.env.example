# Copy to .env.local. Base URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Brandfetch Logo API client ID, for the company logos on the symbol
# badges. Public by design - it ships to the browser in the image URL -
# but keep it out of the repo so the quota stays yours. Free from
# https://developers.brandfetch.com. Leave blank and the badges simply
# render as two letters.
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=
