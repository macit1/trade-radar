      "title": "Primary path",
      "items": [
        "One direction: fetch, store, serve, chart",
        "The database file is the only handoff",
        "Batch CLI on one side, request-time API on the other"
      ]
    },
    {
      "dot": "amber",
      "title": "CLI and storage",
      "items": [
        "--output csv sql picks sinks at run time",
        "Each symbol fetched once; partial bars dropped",
        "prices keyed on (symbol, date), INSERT OR REPLACE",
        "Every write is followed by a validation pass, exit code and all"
      ]
    },
    {
      "dot": "orange",
      "title": "API and dashboard",
      "items": [
        "GET /symbols and /prices, repeated params",
        "CORS scoped to localhost:3000 and GET",
        "Full history cached 5 min: 4,518 bars, ~680 KB",
        "Period and normalise recompute locally"
      ]
    },
    {
      "dot": "rose",
      "title": "External dependencies",
      "items": [
        "Yahoo Finance: unofficial, no API key, no contract",
        "range=max ignores interval and returns monthly bars",
        "Python: requests, pandas, PyYAML, fastapi, uvicorn",
        "JS: next 16, react 19, TanStack Query, lightweight-charts"
      ]
    }
